{
  "name": "dsh-wooden-fish",
  "version": "0.1.0",
  "description": "DSH（DeepSeek Harness）Web 模式插件：在页面中央展示木鱼与木锤，点击木鱼敲击并弹出「功德 +1」，同时播报「南无阿弥陀佛」。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/dsh-wooden-fish.git"
  },
  "homepage": "https://github.com/your-org/dsh-wooden-fish#readme",
  "bugs": {
    "url": "https://github.com/your-org/dsh-wooden-fish/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wooden-fish",
    "muyu",
    "木鱼"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.24.2",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  }
}
